    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/jsdom": "^30.0.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "jsdom": "^30.0.1",
    "tailwindcss": "latest",
    "tsx": "^4.23.1",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
