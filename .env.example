# Public Supabase project settings. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public canonical origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only billing credentials. Configure the Stripe price as a recurring product.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DIRECTORY_PRICE_ID=
# Set true only when the Stripe Price intentionally includes a trial.
STRIPE_TRIALS_ENABLED=false

# Server-only Supabase key used exclusively by verified Stripe webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# Advertising scaffolding is disabled unless explicitly set to true.
NEXT_PUBLIC_ADVERTISING_ENABLED=false

# Never add SUPABASE_SERVICE_ROLE_KEY to browser-exposed NEXT_PUBLIC_* variables.
